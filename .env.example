# 复制本文件为 .env 并填入真实 key。.env 已在 .gitignore 中，不会入库。

# LLM API（至少配一个，DeepSeek 最便宜够用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备选：Aihubmix（聚合网关，可切多种模型）
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_MODEL=gpt-4o-mini

# 可选：LangSmith 链路追踪（Week 3 再用）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
